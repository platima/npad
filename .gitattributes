# Normalize all text files to LF in the repository so mixed-environment
# checkouts (Windows git, WSL git, MSYS2 git in CI) agree on cleanliness -
# otherwise `git describe --dirty` reports phantom-dirty trees and release
# builds lose their clean version string.
* text=auto

# Shell scripts run under sh on Linux/WSL even when checked out on Windows,
# where autocrlf would give them CRLF and sh fails on line 1 ("set: Illegal
# option -"). Always LF.
*.sh text eol=lf

# Explicit binaries
*.ico binary
*.png binary
*.ttf binary
*.otf binary
*.exe binary
*.msi binary
