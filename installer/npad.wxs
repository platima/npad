<?xml version="1.0" encoding="UTF-8"?>
<!--
  npad MSI (silent-install oriented; no UI suite - use msiexec /qn or /qb).

  Build: wix build npad.wxs -arch x64 -d Version=x.y.z -o ../dist/npad-vx.y.z-msi-win-x64.msi
  Windows on Arm: -arch arm64 -d NpadExe=<path to the arm64 npad.exe>, output
  npad-vx.y.z-msi-win-arm64.msi (build-installers.ps1 -Arch arm64). Both share
  the UpgradeCode, so either architecture's MSI upgrades the other in place.

  Scope: per-user by default; machine-wide with ALLUSERS=1 (or the documented
  dual-purpose form, ALLUSERS=2 MSIINSTALLPERUSER=""):
    msiexec /i npad.msi /qn                  (current user)
    msiexec /i npad.msi /qn ALLUSERS=1       (system-wide; needs elevation)
  Every scope-dependent choice below (PATH, fonts, extension defaults) tests
  MachineScope, which is true for both machine-wide spellings. Testing
  MSIINSTALLPERUSER alone was wrong: the package sets it to 1, and Windows
  Installer only acts on it when ALLUSERS is 2 - nothing says it is cleared
  otherwise - so an ALLUSERS=1 deployment could install machine-wide yet take
  the per-user branch (no fonts, PATH written into the installing account's
  own environment).

  Feature selection for deployments (defaults mirror the Inno installer):
    Main (required), PathEnv + OpenWith + AssocText + NotepadAlias + Fonts (on
    by default), AssocMarkdown / AssocData / AssocConfig / AssocLog (off;
    enable via e.g. ADDLOCAL=AssocData,AssocConfig).
    OpenWith only adds npad to the shell's "Open with" chooser for any file
    type; it never changes a default handler.
    PathEnv adds the install dir to PATH so 'npad' resolves from a terminal
    (per-user PATH, or the machine PATH under ALLUSERS=1); suppress with
    ADDLOCAL negation or a transform if unwanted.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef NpadExe ?>
    <?define NpadExe = ..\npad.exe ?>
  <?endif ?>
  <!-- The resolved install scope, as a condition. ALLUSERS=1 is machine-wide
       whatever MSIINSTALLPERUSER says; ALLUSERS=2 is machine-wide only with
       MSIINSTALLPERUSER cleared. Correct whether or not Windows Installer
       rewrites ALLUSERS once it has decided ("1" machine-wide, "" per-user). -->
  <?define MachineScope = (ALLUSERS = 1 OR (ALLUSERS = 2 AND NOT MSIINSTALLPERUSER = 1)) ?>
  <Package Name="npad"
           Manufacturer="Platima"
           Version="$(var.Version)"
           UpgradeCode="6C9F1E28-4B57-4A0D-BE73-8A51F2D90C44"
           Scope="perUserOrMachine"
           InstallerVersion="500">

    <SummaryInformation Description="npad - lightweight cross-platform text editor" />
    <!-- AllowSameVersionUpgrades: the x64 and arm64 MSIs of one release share
         a version, and without it FindRelatedProducts skips an equal-version
         product, so switching architecture would install a second copy rather
         than replace the first. ProductCode is new per build, so a same-version
         reinstall of the same architecture becomes a major upgrade too. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of npad is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs entry. npad.ico became npad-light.ico in v0.28.0
         when the icon gained light/dark variants; this is the default one. -->
    <Icon Id="npadIcon" SourceFile="..\src\platform\npad-light.ico" />
    <Property Id="ARPPRODUCTICON" Value="npadIcon" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPURLINFOABOUT" Value="https://npad.dev" />
    <!-- Record the install folder (MsiGetProductInfo's InstallLocation). The
         in-app updater updates through the MSI only the copy that lives here;
         a portable copy on the same machine must not upgrade this install
         instead of itself (msi_owns_this_copy in ui_win32.c). -->
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize"
                 Sequence="execute" />

    <!-- ============================ Files ============================ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="npad">
        <Component Id="MainExecutable">
          <File Id="npadExe" Source="$(var.NpadExe)" Name="npad.exe" KeyPath="yes" />
        </Component>
        <Component Id="Docs" Guid="D8BDF90B-67FC-4E05-9539-B51C29881D4B">
          <File Source="..\LICENSE" />
          <File Source="..\README.md" />
          <File Source="..\DOCUMENTATION.md" />
        </Component>
        <Directory Id="LicensesDir" Name="licenses">
          <Directory Id="LicIntelDir" Name="IntelOneMono">
            <Component Id="LicIntel">
              <File Id="OflIntel" Source="fonts\IntelOneMono\OFL.txt" />
            </Component>
          </Directory>
          <Directory Id="LicRobotoDir" Name="Roboto">
            <Component Id="LicRoboto">
              <File Id="OflRoboto" Source="fonts\Roboto\OFL.txt" />
            </Component>
          </Directory>
          <Directory Id="LicOpenDysDir" Name="OpenDyslexic">
            <Component Id="LicOpenDys">
              <File Id="OflOpenDys" Source="fonts\OpenDyslexic\OFL.txt" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- ======================= Start Menu shortcut ======================= -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="npadShortcut" Name="npad"
                  Target="[INSTALLFOLDER]npad.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\Platima\npad"
                       Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ========================= Fonts (optional) ========================= -->
    <!-- FontsFolder resolves per scope; TrueType registers via the Font table -->
    <StandardDirectory Id="FontsFolder">
      <Component Id="FontsIntel" Guid="7AD5CEB1-54DB-48B5-9E6D-5744BF6BE443" Permanent="yes">
        <File Source="fonts\IntelOneMono\IntelOneMono-Regular.ttf" TrueType="yes" KeyPath="yes" />
        <File Source="fonts\IntelOneMono\IntelOneMono-Bold.ttf" TrueType="yes" />
        <File Source="fonts\IntelOneMono\IntelOneMono-Italic.ttf" TrueType="yes" />
        <File Source="fonts\IntelOneMono\IntelOneMono-BoldItalic.ttf" TrueType="yes" />
      </Component>
      <Component Id="FontsRoboto" Guid="14507314-1751-4A6F-BC42-2D62EECC8211" Permanent="yes">
        <File Source="fonts\Roboto\Roboto-Regular.ttf" TrueType="yes" KeyPath="yes" />
        <File Source="fonts\Roboto\Roboto-Bold.ttf" TrueType="yes" />
        <File Source="fonts\Roboto\Roboto-Italic.ttf" TrueType="yes" />
        <File Source="fonts\Roboto\Roboto-BoldItalic.ttf" TrueType="yes" />
      </Component>
      <Component Id="FontsOpenDys" Guid="72216378-D4A1-42A5-8C9C-DCD233CF33CA" Permanent="yes">
        <File Source="fonts\OpenDyslexic\OpenDyslexic-Regular.otf" TrueType="yes" KeyPath="yes" />
        <File Source="fonts\OpenDyslexic\OpenDyslexic-Bold.otf" TrueType="yes" />
        <File Source="fonts\OpenDyslexic\OpenDyslexic-Italic.otf" TrueType="yes" />
        <File Source="fonts\OpenDyslexic\OpenDyslexic-BoldItalic.otf" TrueType="yes" />
      </Component>
    </StandardDirectory>

    <!-- ==================== Registry: app registration ==================== -->
    <Component Id="AppPathsNpad" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\npad.exe"
                     Type="string" Value="[INSTALLFOLDER]npad.exe" KeyPath="yes" />
    </Component>
    <Component Id="Capabilities" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities"
                     Name="ApplicationName" Type="string" Value="npad" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities"
                     Name="ApplicationDescription" Type="string"
                     Value="Lightweight cross-platform text editor" />
      <RegistryValue Root="HKMU" Key="Software\RegisteredApplications"
                     Name="npad" Type="string" Value="Software\Platima\npad\Capabilities" />
      <!-- Icon for the Settings > Default apps entry -->
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities"
                     Name="ApplicationIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
    </Component>

    <!-- ============ "Open with" for any file type (always on) ============ -->
    <!-- Purely additive: these keys add npad to the shell's chooser lists and
         can never change a default handler. No SupportedTypes subkey - it would
         FILTER npad out of "Open with" for every type not listed - and never a
         NoOpenWith value, which would suppress npad entirely. -->
    <Component Id="OpenWithAny" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\Applications\npad.exe"
                     Name="FriendlyAppName" Type="string" Value="npad" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\Applications\npad.exe\DefaultIcon"
                     Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\Applications\npad.exe\shell\open\command"
                     Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <!-- Explorer reads OpenWithList entries as SUBKEYS named after the exe -->
      <RegistryKey Root="HKMU" Key="Software\Classes\*\OpenWithList\npad.exe"
                   ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes" />
      <!-- Guarantee the whole app-registration subtree goes on uninstall -->
      <RemoveRegistryKey Root="HKMU" Key="Software\Classes\Applications\npad.exe"
                         Action="removeOnUninstall" />
    </Component>

    <!-- 'notepad' alias takeover (Run box / ShellExecute). The Windows 11
         Store Notepad execution alias must be disabled by hand in Settings. -->
    <Component Id="NotepadAliasReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\notepad.exe"
                     Type="string" Value="[INSTALLFOLDER]npad.exe" KeyPath="yes" />
    </Component>

    <!-- PATH entry: cmd.exe / PowerShell resolve bare 'npad' from PATH only
         (App Paths above serves Win+R / ShellExecute). <Environment> has a
         static System attribute, so a per-user install writes the user PATH
         and an all-users install writes the machine PATH; exactly one
         component is active per scope. -->
    <Component Id="PathEnvUser" Directory="INSTALLFOLDER" Condition="NOT $(var.MachineScope)">
      <RegistryValue Root="HKCU" Key="Software\Platima\npad" Name="pathenv"
                     Type="integer" Value="1" KeyPath="yes" />
      <Environment Id="NpadPathUser" Name="PATH" Value="[INSTALLFOLDER]"
                   Part="last" Action="set" Permanent="no" System="no" />
    </Component>
    <Component Id="PathEnvMachine" Directory="INSTALLFOLDER" Condition="$(var.MachineScope)">
      <RegistryValue Root="HKLM" Key="Software\Platima\npad" Name="pathenv"
                     Type="integer" Value="1" KeyPath="yes" />
      <Environment Id="NpadPathMachine" Name="PATH" Value="[INSTALLFOLDER]"
                   Part="last" Action="set" Permanent="no" System="yes" />
    </Component>

    <!-- ================= Registry: per-extension associations ================= -->
    <Component Id="AssocTxtReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.txt" Type="string" Value="Text File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.txt\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.txt\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.txt\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.txt\OpenWithProgids" Name="npad.txt" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".txt" Type="string" Value="npad.txt" />
    </Component>
    <Component Id="AssocLogReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.log" Type="string" Value="Log File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.log\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.log\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.log\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.log\OpenWithProgids" Name="npad.log" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".log" Type="string" Value="npad.log" />
    </Component>
    <Component Id="AssocIniReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.ini" Type="string" Value="INI Configuration File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.ini\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.ini\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.ini\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.ini\OpenWithProgids" Name="npad.ini" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".ini" Type="string" Value="npad.ini" />
    </Component>
    <Component Id="AssocCfgReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.cfg" Type="string" Value="Config File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.cfg\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.cfg\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.cfg\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.cfg\OpenWithProgids" Name="npad.cfg" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".cfg" Type="string" Value="npad.cfg" />
    </Component>
    <Component Id="AssocConfReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.conf" Type="string" Value="Config File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.conf\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.conf\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.conf\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.conf\OpenWithProgids" Name="npad.conf" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".conf" Type="string" Value="npad.conf" />
    </Component>
    <!-- Markdown group -->
    <Component Id="AssocMdReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.md" Type="string" Value="Markdown Document" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.md\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.md\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.md\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.md\OpenWithProgids" Name="npad.md" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".md" Type="string" Value="npad.md" />
    </Component>
    <Component Id="AssocMarkdownReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.markdown" Type="string" Value="Markdown Document" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.markdown\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.markdown\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.markdown\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.markdown\OpenWithProgids" Name="npad.markdown" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".markdown" Type="string" Value="npad.markdown" />
    </Component>
    <!-- Data group -->
    <Component Id="AssocCsvReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.csv" Type="string" Value="CSV File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.csv\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.csv\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.csv\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.csv\OpenWithProgids" Name="npad.csv" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".csv" Type="string" Value="npad.csv" />
    </Component>
    <Component Id="AssocTsvReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.tsv" Type="string" Value="TSV File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.tsv\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.tsv\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.tsv\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.tsv\OpenWithProgids" Name="npad.tsv" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".tsv" Type="string" Value="npad.tsv" />
    </Component>
    <Component Id="AssocJsonReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.json" Type="string" Value="JSON File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.json\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.json\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.json\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.json\OpenWithProgids" Name="npad.json" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".json" Type="string" Value="npad.json" />
    </Component>
    <Component Id="AssocXmlReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.xml" Type="string" Value="XML File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.xml\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.xml\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.xml\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.xml\OpenWithProgids" Name="npad.xml" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".xml" Type="string" Value="npad.xml" />
    </Component>
    <Component Id="AssocYamlReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yaml" Type="string" Value="YAML File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yaml\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yaml\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yaml\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.yaml\OpenWithProgids" Name="npad.yaml" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".yaml" Type="string" Value="npad.yaml" />
    </Component>
    <Component Id="AssocYmlReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yml" Type="string" Value="YAML File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yml\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yml\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.yml\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.yml\OpenWithProgids" Name="npad.yml" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".yml" Type="string" Value="npad.yml" />
    </Component>
    <Component Id="AssocTomlReg" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.toml" Type="string" Value="TOML File" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.toml\DefaultIcon" Type="string" Value="[INSTALLFOLDER]npad.exe,0" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.toml\shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\npad.toml\shell\print\command" Type="string" Value="&quot;[INSTALLFOLDER]npad.exe&quot; /p &quot;%1&quot;" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.toml\OpenWithProgids" Name="npad.toml" Type="string" Value="" />
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\Capabilities\FileAssociations" Name=".toml" Type="string" Value="npad.toml" />
    </Component>


    <!-- ============= Extension default values (who owns .txt) =============
         Setting Software\Classes\.txt's default value is what makes npad the
         type's handler where Windows still lets a registration decide. MSI
         removes a value it wrote whatever it then holds, and has no way to put
         back what was there before. Machine-wide that was Windows' own ProgID
         (txtfile, inifile, xmlfile) or another app's (Excel.CSV), so an
         all-users uninstall left .txt with no type name, no icon and no New >
         Text Document. Each extension is therefore claimed only when its
         default value in this install's hive is empty or already npad's
         (AppSearch reads both hives; the scope picks one; ~= compares
         without case, as Windows does). npad is offered for
         the type either way, through OpenWithProgids and Capabilities. The
         key path is npad's own record of the claim, not the shared value. -->
    <Property Id="NPAD_DEF_TXT_LM" Secure="yes">
      <RegistrySearch Root="HKLM" Key="Software\Classes\.txt" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="NPAD_DEF_TXT_CU" Secure="yes">
      <RegistrySearch Root="HKCU" Key="Software\Classes\.txt" Type="raw" />
    </Property>
    <Component Id="ClaimDefaultTxt" Directory="INSTALLFOLDER"
               Condition="($(var.MachineScope) AND (NOT NPAD_DEF_TXT_LM OR NPAD_DEF_TXT_LM ~= &quot;npad.txt&quot;)) OR (NOT $(var.MachineScope) AND (NOT NPAD_DEF_TXT_CU OR NPAD_DEF_TXT_CU ~= &quot;npad.txt&quot;))">
      <RegistryValue Root="HKMU" Key="Software\Platima\npad\ClaimedDefaults" Name=".txt"
                     Type="string" Value="npad.txt" KeyPath="yes" />
      <RegistryValue Root="HKMU" Key="Software\Classes\.txt" Type="string" Value="npad.txt" />
    </Component>
    <Property Id="NPAD_DEF_LOG_LM" Secure="yes">
      <RegistrySearch Root="HKLM" Key="Software\Classes\.log" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="NPAD_DEF_LOG_CU" Secure="yes">
      <RegistrySearch Root="HKCU" Key="Software\Classes\.log" Type="raw" />
    </Property>
    <Component Id="ClaimDefaultLog" Directory="INSTALLFOLDER"
