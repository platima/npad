    <!-- ============================ Features ============================ -->
    <Feature Id="Main" Title="npad text editor" Level="1" AllowAbsent="no">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="Docs" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AppPathsNpad" />
      <ComponentRef Id="Capabilities" />
    </Feature>
    <!-- PATH is on by default (level 1); exactly one scope component installs -->
    <Feature Id="PathEnv" Title="Add npad to PATH" Level="1">
      <ComponentRef Id="PathEnvUser" />
      <ComponentRef Id="PathEnvMachine" />
    </Feature>
    <!-- Additive only (never changes a default handler), so on by default;
         deployers can still drop it with REMOVE=OpenWith -->
    <Feature Id="OpenWith" Title="Offer npad in the Windows &quot;Open with&quot; list" Level="1">
      <ComponentRef Id="OpenWithAny" />
    </Feature>
    <!-- File associations grouped like the Inno installer's tasks -->
    <Feature Id="AssocText" Title="Associate text files (.txt)" Level="1">
      <ComponentRef Id="AssocTxtReg" />
      <ComponentRef Id="ClaimDefaultTxt" />
    </Feature>
    <Feature Id="AssocMarkdown" Title="Associate Markdown &amp; documents (.md, .markdown)" Level="2">
      <ComponentRef Id="AssocMdReg" />
      <ComponentRef Id="ClaimDefaultMd" />
      <ComponentRef Id="AssocMarkdownReg" />
      <ComponentRef Id="ClaimDefaultMarkdown" />
    </Feature>
    <Feature Id="AssocData" Title="Associate data files (.csv, .tsv, .json, .xml, .yaml, .yml, .toml)" Level="2">
      <ComponentRef Id="AssocCsvReg" />
      <ComponentRef Id="ClaimDefaultCsv" />
      <ComponentRef Id="AssocTsvReg" />
      <ComponentRef Id="ClaimDefaultTsv" />
      <ComponentRef Id="AssocJsonReg" />
      <ComponentRef Id="ClaimDefaultJson" />
      <ComponentRef Id="AssocXmlReg" />
      <ComponentRef Id="ClaimDefaultXml" />
      <ComponentRef Id="AssocYamlReg" />
      <ComponentRef Id="ClaimDefaultYaml" />
      <ComponentRef Id="AssocYmlReg" />
      <ComponentRef Id="ClaimDefaultYml" />
      <ComponentRef Id="AssocTomlReg" />
      <ComponentRef Id="ClaimDefaultToml" />
    </Feature>
    <Feature Id="AssocConfig" Title="Associate config files (.ini, .cfg, .conf)" Level="2">
      <ComponentRef Id="AssocIniReg" />
      <ComponentRef Id="ClaimDefaultIni" />
      <ComponentRef Id="AssocCfgReg" />
      <ComponentRef Id="ClaimDefaultCfg" />
      <ComponentRef Id="AssocConfReg" />
      <ComponentRef Id="ClaimDefaultConf" />
    </Feature>
    <Feature Id="AssocLog" Title="Associate log files (.log)" Level="2">
      <ComponentRef Id="AssocLogReg" />
      <ComponentRef Id="ClaimDefaultLog" />
    </Feature>
    <Feature Id="NotepadAlias" Title="Open 'notepad' with npad" Level="1">
      <ComponentRef Id="NotepadAliasReg" />
    </Feature>
    <!-- MSI's FontsFolder always resolves to C:\Windows\Fonts (no per-user
         redirect), so fonts are a per-machine-only feature here: a per-user
         install would fail writing them (error 1603). Per-user font installs
         are available via the Inno Setup installer instead. -->
    <Feature Id="Fonts" Title="Bundled open-source fonts (SIL OFL; machine-wide installs only)" Level="1">
      <Level Value="0" Condition="NOT $(var.MachineScope)" />
      <ComponentRef Id="FontsIntel" />
      <ComponentRef Id="FontsRoboto" />
      <ComponentRef Id="FontsOpenDys" />
      <ComponentRef Id="LicIntel" />
      <ComponentRef Id="LicRoboto" />
      <ComponentRef Id="LicOpenDys" />
    </Feature>
  </Package>
</Wix>
